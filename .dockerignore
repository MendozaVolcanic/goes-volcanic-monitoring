# Excluir del build context Docker — acelera build y reduce tamano imagen
.git/
.github/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.streamlit/

# Output dirs (regenerados por workflows)
out_animation_cache/
out_backfill/
out_hires/

# Logs locales
*.log

# Docs pesadas no necesarias en runtime
docs/manuales_pdf/
docs/papers_links/
docs/*.pdf
"Logs pruebas/"

# Data raw (gitignored ya, pero por las dudas)
data/raw/
data/processed/
data/cache/

