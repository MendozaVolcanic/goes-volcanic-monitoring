# Excluir del build context Docker — acelera build y reduce tamano imagen
.git/
.github/
.venv/
__pycache__/
*.pyc
.pytest_cache/
# .streamlit: excluir SOLO secrets (sensible), PERMITIR config.toml.
# Antes excluiamos todo `.streamlit/` -> el tema dark (config.toml) nunca
# llegaba al container HF y la app se veia con tema light roto. (mayo 2026)
.streamlit/secrets.toml

# Output dirs (regenerados por workflows)
out_animation_cache/
out_backfill/
out_hires/

# Logs locales
*.log

# Docs pesadas no necesarias en runtime
docs/manuales_pdf/
docs/papers_links/
docs/*.pdf
"Logs pruebas/"

# Data raw (gitignored ya, pero por las dudas)
data/raw/
data/processed/
data/cache/

# Shapefiles raw (ya extrajimos lo necesario a chile_geometry.json)
data/borders/V4_Limite_Internacional.kmz
data/borders/V4_limite_Internacional_Recuadro_CHS/
data/borders/OSM/

# Logs descargados de Streamlit Cloud (los txt que descarga el user)
# IMPORTANTE: NO usar `*.txt` porque excluiria requirements.txt y runtime.txt.
# Match solo el patron especifico del nombre de los logs.
logs-mendozavolcanic-*.txt
